{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "autoupdate": true,
  "agent": {
    "build": {
      "path": "agent/build.md",
      "model": "github-copilot/claude-opus-4.6",
      "permission": {
        "task": {
          "coder": "allow",
          "researcher": "allow",
          "reviewer": "allow",
          "notes": "allow"
        }
      }
    },
    "plan": {
      "path": "agent/plan.md",
      "model": "github-copilot/claude-opus-4.6",
      "permission": {
        "task": {
          "researcher": "allow",
          "reviewer": "allow",
          "coder": "deny",
          "notes": "allow"
        }
      }
    },
    "coder": {
      "path": "agent/coder.md",
      "model": "anthropic/claude-sonnet-4-6",
      "steps": 50
    },
    "researcher": {
      "path": "agent/researcher.md",
      "model": "anthropic/claude-haiku-4-5",
      "steps": 20
    },
    "reviewer": {
      "path": "agent/reviewer.md",
      "model": "anthropic/claude-sonnet-4-6",
      "steps": 30
    },
    "notes": {
      "path": "agent/notes.md",
      "model": "anthropic/claude-sonnet-4-6",
      "steps": 30
    }
  },
  "lsp": {
    "ruby-lsp": {
      "command": [
        "ruby-lsp"
      ]
    }
  },
  "mcp": {
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "obsidian": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mauricio.wolff/mcp-obsidian@latest",
        "{env:OBSIDIAN_VAULT}"
      ]
    },
    "excalidraw": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@scofieldfree/excalidraw-mcp"
      ]
    },
    "github": {
      "type": "local",
      "command": [
        "github-mcp-server",
        "stdio"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "atlassian": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-atlassian"
      ],
      "environment": {
        "JIRA_URL": "https://vinted.atlassian.net",
        "JIRA_USERNAME": "{env:JIRA_USERNAME}",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}",
        "CONFLUENCE_URL": "https://vinted.atlassian.net/wiki",
        "CONFLUENCE_USERNAME": "{env:JIRA_USERNAME}",
        "CONFLUENCE_API_TOKEN": "{env:JIRA_API_TOKEN}"
      }
    },
    "figma-console": {
      "type": "local",
      "command": [
        "bunx",
        "cursor-talk-to-figma-mcp@latest"
      ]
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "theme": "one-dark",
  "autoupdate": true,
  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": {
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "path": "agent/build.md",
      "model": "anthropic/claude-opus-4-6",
      "permission": {
        "task": {
          "coder": "allow",
          "researcher": "allow",
          "reviewer": "allow"
        }
      }
    },
    "plan": {
      "path": "agent/plan.md",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "task": {
          "researcher": "allow",
          "reviewer": "allow",
          "coder": "deny"
        }
      }
    },
    "coder": {
      "path": "agent/coder.md",
      "model": "anthropic/claude-sonnet-4-6",
      "steps": 50
    },
    "researcher": {
      "path": "agent/researcher.md",
      "model": "anthropic/claude-haiku-4-5",
      "steps": 20
    },
    "reviewer": {
      "path": "agent/reviewer.md",
      "model": "anthropic/claude-sonnet-4-6",
      "steps": 30
    }
  },
  "mcp": {
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "parallel_search": {
      "type": "remote",
      "url": "https://search-mcp.parallel.ai/mcp"
    },
    "cloudflare_docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    }
  }
}

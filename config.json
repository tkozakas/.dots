{
  "common": {
    "packages": [
      "unstable.sesh",
      "unstable.zip",
      "unstable.unzip",
      "unstable.bitwarden-cli",
      "unstable.nerd-fonts.jetbrains-mono"
    ],
    "xdgLinks": {
      "nvim": "nvim",
      "alacritty": "alacritty",
      "lazygit": "lazygit",
      "k9s": "k9s",
      "sesh": "sesh"
    },
    "homeLinks": {
      ".omp/agent": "pi",
      ".tmux": "tmux",
      ".tmux.conf": "tmux/.tmux.conf",
      ".tmux.conf.local": "tmux/.tmux.conf.local",
      ".zshrc": "zsh/.zshrc",
      ".zshenv": "zsh/.zshenv",
      ".zshfn": "zsh/.zshfn",
      ".editorconfig": "nvim/editorconfig",
      ".gitignore_global": "git/.gitignore_global",
      ".gitconfig": "git/.gitconfig",
      ".local/bin/git-scripts": "git"
    },
    "hooks": [
      "git config --global core.excludesFile ~/.gitignore_global"
    ]
  },
  "linux": {
    "packages": [
      "unstable.docker",
      "unstable.docker-compose",
      "unstable.firefox",
      "unstable.python3",
      "unstable.noto-fonts",
      "unstable.noto-fonts-color-emoji",
      "unstable.noto-fonts-cjk-sans",
      "hyprland",
      "hyprlock",
      "hyprpaper",
      "hypridle",
      "hyprutils",
      "waybar",
      "rofi",
      "swww",
      "slurp",
      "grim",
      "wl-clipboard",
      "unstable.nautilus",
      "unstable.discord",
      "unstable.spotify",
      "unstable.jetbrains-toolbox"
    ],
    "xdgLinks": {
      "hypr": "hypr",
      "wireplumber": "wireplumber",
      "Code/User/settings.json": "vscode/settings.json"
    },
    "homeLinks": {},
    "hooks": []
  },
  "darwin": {
    "packages": [],
    "xdgLinks": {},
    "homeLinks": {
      ".aerospace.toml": "aerospace/.aerospace.toml",
      "Library/Application Support/Code/User/settings.json": "vscode/settings.json"
    },
    "hooks": [
      "[ -x /opt/homebrew/bin/brew ] || [ -x /usr/local/bin/brew ] || /bin/bash -c \"$(/usr/bin/curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"",
      "[ -d /Applications/DbGate.app ] || { [ -x /opt/homebrew/bin/brew ] && /opt/homebrew/bin/brew install --cask --no-quarantine dbgate; } || { [ -x /usr/local/bin/brew ] && /usr/local/bin/brew install --cask --no-quarantine dbgate; }",
      "command -v omp >/dev/null 2>&1 || { [ -x /opt/homebrew/bin/brew ] && /opt/homebrew/bin/brew install can1357/tap/omp; } || { [ -x /usr/local/bin/brew ] && /usr/local/bin/brew install can1357/tap/omp; }",
      "[ -d /Applications/Raycast.app ] || { [ -x /opt/homebrew/bin/brew ] && /opt/homebrew/bin/brew install --cask raycast; } || { [ -x /usr/local/bin/brew ] && /usr/local/bin/brew install --cask raycast; }"
      ,"[ -d /Applications/AeroSpace.app ] || { [ -x /opt/homebrew/bin/brew ] && /opt/homebrew/bin/brew install --cask nikitabobko/tap/aerospace; } || { [ -x /usr/local/bin/brew ] && /usr/local/bin/brew install --cask nikitabobko/tap/aerospace; }"
      ,"[ -d /Applications/Almighty.app ] || { [ -x /opt/homebrew/bin/brew ] && /opt/homebrew/bin/brew install --cask almighty; } || { [ -x /usr/local/bin/brew ] && /usr/local/bin/brew install --cask almighty; }"
    ]
  }
}

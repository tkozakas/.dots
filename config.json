{
  "common": {
    "packages": [
      "unstable.sesh",
      "unstable.zip",
      "unstable.unzip",
      "unstable.bitwarden-cli",
      "unstable.nerd-fonts.jetbrains-mono"
    ],
    "xdgLinks": {
      "nvim": "nvim",
      "alacritty": "alacritty",
      "lazygit": "lazygit",
      "k9s": "k9s",
      "sesh": "sesh"
    },
    "homeLinks": {
      ".omp/agent": "pi",
      ".tmux": "tmux",
      ".tmux.conf": "tmux/.tmux.conf",
      ".tmux.conf.local": "tmux/.tmux.conf.local",
      ".zshrc": "zsh/.zshrc",
      ".zshenv": "zsh/.zshenv",
      ".zshfn": "zsh/.zshfn",
      ".editorconfig": "nvim/editorconfig",
      ".gitignore_global": "git/.gitignore_global",
      ".gitconfig": "git/.gitconfig",
      ".local/bin/git-scripts": "git"
    },
    "hooks": [
      "git config --global core.excludesFile ~/.gitignore_global"
    ]
  },
  "linux": {
    "packages": [
      "unstable.docker",
      "unstable.docker-compose",
      "unstable.firefox",
      "unstable.python3",
      "unstable.noto-fonts",
      "unstable.noto-fonts-color-emoji",
      "unstable.noto-fonts-cjk-sans",
      "hyprland",
      "hyprlock",
      "hyprpaper",
      "hypridle",
      "hyprutils",
      "waybar",
      "rofi",
      "swww",
      "slurp",
      "grim",
      "wl-clipboard",
      "unstable.nautilus",
      "unstable.discord",
      "unstable.spotify",
      "unstable.jetbrains-toolbox"
    ],
    "xdgLinks": {
      "hypr": "hypr",
      "wireplumber": "wireplumber",
      "Code/User/settings.json": "vscode/settings.json"
    },
    "homeLinks": {},
    "hooks": []
  },
  "darwin": {
    "packages": [],
    "casks": [
      "dbgate --no-quarantine",
      "raycast",
      "nikitabobko/tap/aerospace",
      "vorssaint",
      "atoll"
    ],
    "brews": [
      "can1357/tap/omp"
    ],
    "xdgLinks": {},
    "homeLinks": {
      ".aerospace.toml": "aerospace/.aerospace.toml",
      "Library/Application Support/Code/User/settings.json": "vscode/settings.json"
    },
    "hooks": [
      "defaults read com.vorssaint.utils >/dev/null 2>&1 || defaults import com.vorssaint.utils $HOME/.dots/configs/vorssaint/settings.plist",
      "defaults read com.raycast.macos >/dev/null 2>&1 || defaults import com.raycast.macos $HOME/.dots/configs/raycast/settings.plist",
      "defaults read com.Ebullioscopic.Atoll >/dev/null 2>&1 || { [ -f $HOME/.dots/configs/atoll/settings.plist ] && defaults import com.Ebullioscopic.Atoll $HOME/.dots/configs/atoll/settings.plist; } || true"
    ]
  }
}
